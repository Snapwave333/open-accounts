{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenAccounts",
  "version": "0.1.0",
  "identifier": "com.openaccounts.desktop",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:4200",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../angular/dist/angular/browser"
  },
  "app": {
    "windows": [
      {
        "title": "OpenAccounts — Autonomous Account Management",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
